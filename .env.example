# Copy this file to `.env` and fill in your own values. NEVER commit a real token.
# `.env` is git-ignored; this `.env.example` is tracked as a template only.

# Official X (Twitter) API v2 bearer token, used by src/x_ingestion.py.
# Obtain it from your own X Developer account. Leave blank here.
X_BEARER_TOKEN=

# Optional: NASA FIRMS MAP_KEY for the satellite verification step.
FIRMS_MAP_KEY=
